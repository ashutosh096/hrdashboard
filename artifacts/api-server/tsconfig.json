{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/cleanup_*.ts",
    "src/e2e_*.ts",
    "src/test_*.ts",
    "src/qa_*.ts",
    "src/run_*.ts",
    "src/dump_*.ts",
    "src/db_*.ts",
    "src/check_*.ts",
    "src/export_*.ts",
    "src/generate_*.ts"
  ]
}
